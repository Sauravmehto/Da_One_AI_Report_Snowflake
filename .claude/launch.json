{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "node frontend/node_modules/vite/bin/vite.js frontend --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
